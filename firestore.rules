rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && (
          request.auth.token.email == 'abinsajan36@gmail.com' ||
          request.auth.token.email == 'annanvasu36@gmail.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin') ||
          ('email' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'abinsajan36@gmail.com' ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'annanvasu36@gmail.com'))
        ))
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        ('email' in request.auth.token && request.auth.token.email == 'admin@7seasons.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          )) ||
          ('email' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'admin@7seasons.com')
        ))
      );
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /combos/{comboId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /dailyDeals/{dealId} {
      allow read, write: if true;
    }

    match /coupons/{couponId} {
      allow read, write: if true;
    }

    match /banners/{bannerId} {
      allow read, write: if true;
    }

    match /blogs/{blogId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /plantCareGuides/{guideId} {
      allow read, write: if true;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    match /settings/{userId} {
      allow read, write: if true;
    }

    match /storeSettings/{settingId} {
      allow read, write: if true;
    }
  }
}

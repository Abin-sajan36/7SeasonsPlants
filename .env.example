# GEMINI_API_KEY: Required for Gemini AI API calls (Plant Doctor, AI description generator).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# RAZORPAY_KEY_ID: Razorpay public key ID for payment gateway
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Razorpay private key secret (server-side only)
RAZORPAY_KEY_SECRET=""

# SMTP Email Configuration (Optional: for sending real OTP verification emails)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Firebase Configuration (Optional: for custom domain / Vercel overrides)
# Defaults are auto-loaded from firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""

